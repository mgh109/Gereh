# Target runtime: PHP 8.3
# Application
CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.forceGlobalSecureRequests = false

# MySQL
database.default.hostname = localhost
database.default.database = gereh
database.default.username = gereh_user
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# OTP policy (provider credentials will be configured separately)
GEREH_OTP_TTL_SECONDS = 120
GEREH_OTP_RESEND_COOLDOWN_SECONDS = 60
GEREH_OTP_MAX_ATTEMPTS = 5
GEREH_OTP_PROVIDER = melipayamak

# ZarinPal — never commit real credentials
ZARINPAL_MERCHANT_ID =
ZARINPAL_SANDBOX = true
ZARINPAL_CALLBACK_URL = 'http://localhost:8080/payment/zarinpal/callback'

# Upload policy
GEREH_UPLOAD_DISK = local
GEREH_PRODUCT_IMAGE_MAX_KB = 5120

# Customer OTP: generate a private random value of at least 32 characters.
# NEVER commit the real secret or SMS token.
GEREH_OTP_HASH_SECRET =
GEREH_SMS_WEBHOOK_URL =
GEREH_SMS_WEBHOOK_TOKEN =

# Required before a payment-capable checkout can be enabled.
GEREH_STANDARD_SHIPPING_TOMAN =

# Payment must stay OFF until ZarinPal keys, callback, shipping and refund handling are verified.
GEREH_CHECKOUT_ENABLED = false

# Melipayamak REST pattern service. Credentials stay only on server (never in database).
GEREH_MELIPAYAMAK_USERNAME =
GEREH_MELIPAYAMAK_PASSWORD =
# Provider and pattern/bodyId are enabled under /admin/settings/sms after migration.
